{
  "name": "@audio/neural-tts",
  "version": "0.1.0",
  "description": "Text to speech — SpeechT5 (and VITS/mms-tts-eng) running locally via transformers.js/ONNX Runtime, in Node and the browser",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "main": "tts.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./tts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "tts.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "dependencies": {
    "@audio/resample-sinc": "^1.1.2",
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "tst": "^9.4.0"
  },
  "keywords": [
    "audio",
    "ml",
    "neural",
    "tts",
    "text-to-speech",
    "speecht5",
    "vits",
    "transformers.js",
    "onnx"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/neural.git",
    "directory": "packages/neural-tts"
  },
  "funding": "https://github.com/sponsors/audiojs"
}
