  "description": "Speech-to-text — Whisper (OpenAI, MIT) running locally via transformers.js/ONNX Runtime, in Node and the browser",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "main": "asr.js",
  "exports": {
    ".": "./asr.js",
    "./package.json": "./package.json"
