{
  "name": "@audio/neural-denoise",
  "version": "0.5.1",
  "description": "Neural speech enhancement: RNNoise (Valin 2018) in pure JS, bit-exact to its C, weights bundled; DeepFilterNet3 through ONNX Runtime, matching the Python original; music passes through untouched (inaSpeechSegmenter's speech/music/noise CNN)",
  "type": "module",
  "sideEffects": false,
  "main": "denoise.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./denoise.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./worklet": "./worklet.js",
    "./rnnoise.bin": "./rnnoise.bin",
    "./guard.bin": "./guard.bin",
    "./package.json": "./package.json"
  },
  "files": [
    "denoise.js",
    "audio.js",
    "rnnoise.js",
    "deepfilter.js",
    "fft.js",
    "worklet.js",
    "rnnoise.bin",
    "gemv.wat",
    "guard.js",
    "guard.bin",
    "gemm.wat",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "audio.d.ts"
  ],
  "dependencies": {
    "@audio/neural-runtime": "^0.1.0",
    "@audio/resample-sinc": "^1.3.0"
  },
  "devDependencies": {
    "audio-lena": "^3.0.1",
    "onnxruntime-node": "^1.29.0",
    "tst": "^9.4.0"
  },
  "scripts": {
    "test": "node test.js"
  },
  "keywords": [
    "audio",
    "ml",
    "neural",
    "denoise",
    "noise-suppression",
    "speech-enhancement",
    "rnnoise",
    "deepfilternet",
    "audioworklet",
    "onnx"
  ],
  "license": "BSD-3-Clause AND MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "contributors": [
    "Jean-Marc Valin, Xiph.Org Foundation, Mozilla, Amazon and the RNNoise authors (RNNoise)",
    "Hendrik Schröter (DeepFilterNet)",
    "David Doukhan, Ina (inaSpeechSegmenter)"
  ],
  "audio": "./audio.js",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/neural.git",
    "directory": "packages/neural-denoise"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "publishConfig": {
    "access": "public"
  }
}
