{
  "name": "@audio/neural-runtime",
  "version": "0.1.1",
  "description": "Model inference adapter — ONNX Runtime (Node/wasm/webgpu) behind one worklet-ready interface",
  "type": "module",
  "sideEffects": false,
  "main": "runtime.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./runtime.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "runtime.js",
    "index.d.ts"
  ],
  "peerDependencies": {
    "onnxruntime-node": ">=1.14.0",
    "onnxruntime-web": ">=1.14.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "onnxruntime-node": "^1.29.0",
    "tst": "^9.4.0"
  },
  "scripts": {
    "test": "node test.js"
  },
  "keywords": [
    "audio",
    "ml",
    "neural",
    "onnx",
    "onnxruntime",
    "inference",
    "runtime",
    "worklet"
  ],
  "license": "MIT",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/neural.git",
    "directory": "packages/neural-runtime"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "publishConfig": {
    "access": "public"
  }
}
