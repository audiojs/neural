{
  "name": "@audio/neural-tag",
  "version": "0.1.0",
  "description": "What a sound is, in AudioSet's 521 classes: Google's YAMNet (Apache-2.0) scores each 0.96 s patch, its log-mel features in JS as upstream computes them, the network through @audio/neural-runtime",
  "type": "module",
  "sideEffects": false,
  "main": "tag.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./tag.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "tag.js",
    "classes.js",
    "index.d.ts",
    "scripts/*.mjs",
    "scripts/*.py",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@audio/neural-runtime": "^0.2.0",
    "@audio/resample-sinc": "^1.3.0",
    "fourier-transform": "^2.4.1"
  },
  "devDependencies": {
    "audio-lena": "^3.0.1",
    "onnxruntime-node": "^1.29.0",
    "tst": "^9.4.0"
  },
  "scripts": {
    "test": "node test.js",
    "prepublishOnly": "node ../../../compile/tools/tested.js"
  },
  "keywords": [
    "audio",
    "ml",
    "neural",
    "audio-tagging",
    "audio-classification",
    "sound-event",
    "audioset",
    "yamnet",
    "onnx"
  ],
  "license": "Apache-2.0",
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "contributors": [
    "Manoj Plakal, Dan Ellis and the TensorFlow Authors (YAMNet)"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/neural.git",
    "directory": "packages/neural-tag"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "publishConfig": {
    "access": "public"
  }
}
