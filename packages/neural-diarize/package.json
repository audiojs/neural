{
  "name": "@audio/neural-diarize",
  "version": "0.1.0",
  "description": "Speaker diarization — who spoke when (WavLM x-vector embeddings, agglomerative clustering)",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "main": "diarize.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./diarize.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "diarize.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "dependencies": {
    "@audio/resample-sinc": "^1.1.2",
    "@audio/vad": "^1.0.1",
