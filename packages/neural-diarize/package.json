  },
  "peerDependencies": {
    "@audio/subtitle": "*"
  },
  "peerDependenciesMeta": {
    "@audio/subtitle": {
      "optional": true
    }
  },
  "devDependencies": {
    "@audio/shift-psola": "^1.0.3",
    "audio-lena": "^3.0.1",
    "tst": "^9.4.0"
  },
  "keywords": [
    "audio",
    "ml",
    "neural",
    "diarization",
    "speaker",
    "speaker-verification",
    "wavlm",
    "x-vector",
    "clustering",
    "transformers.js",
    "onnx"
  ],
